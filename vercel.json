{
  "crons": [
    {
      "path": "/api/cron/metrics-sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/key-results-sync",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/blog-sync",
      "schedule": "0 8,14,20 * * *"
    },
    {
      "path": "/api/cron/blog-details-sync",
      "schedule": "0 9,15,21 * * *"
    },
    {
      "path": "/api/cron/case-studies-sync",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/outils",
      "destination": "/marketplace",
      "permanent": true
    },
    {
      "source": "/donnees-publiques",
      "destination": "/objectifs",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://www.corentinrobert.fr/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "corentinrobert.fr"
        }
      ],
      "destination": "https://www.corentinrobert.fr/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
