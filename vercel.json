{
  "crons": [
    {
      "path": "/api/cron/metrics-sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/key-results-sync",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/blog-sync",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/blog-details-sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/case-studies-sync",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/marketplace-enrich",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/cron/apify-actors-sync",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/apify-actors-videos-sync",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/apify-actors-stats-daily",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/generate-new-case-studies",
      "schedule": "0 6,17 * * *"
    },
    {
      "path": "/api/cron/tella-marketplace-videos",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/sync-stripe-products",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/analyse-ctr",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/case-studies-ranking-check",
      "schedule": "0 8 * * 0"
    }
  ],
  "redirects": [
    {
      "source": "/cas-usage/reseaux-sociaux",
      "destination": "/cas-usage/reseaux-sociaux-lead-generation",
      "permanent": true
    },
    {
      "source": "/cas-usage/reseaux-sociaux/:path*",
      "destination": "/cas-usage/reseaux-sociaux-lead-generation/:path*",
      "permanent": true
    },
    {
      "source": "/cas-usage/lead-gen",
      "destination": "/cas-usage/reseaux-sociaux-lead-generation",
      "permanent": true
    },
    {
      "source": "/cas-usage/lead-gen/:path*",
      "destination": "/cas-usage/reseaux-sociaux-lead-generation/:path*",
      "permanent": true
    },
    {
      "source": "/cas-usage/securite-it",
      "destination": "/cas-usage/autres",
      "permanent": true
    },
    {
      "source": "/cas-usage/securite-it/:path*",
      "destination": "/cas-usage/autres/:path*",
      "permanent": true
    },
    {
      "source": "/cas-usage/reseaux-sociaux-lead-gen",
      "destination": "/cas-usage/reseaux-sociaux-lead-generation",
      "permanent": true
    },
    {
      "source": "/cas-usage/reseaux-sociaux-lead-gen/:path*",
      "destination": "/cas-usage/reseaux-sociaux-lead-generation/:path*",
      "permanent": true
    },
    {
      "source": "/databases/:path*",
      "destination": "/marketplace",
      "permanent": true
    },
    {
      "source": "/page-services",
      "destination": "/marketplace",
      "permanent": true
    },
    {
      "source": "/outils",
      "destination": "/marketplace",
      "permanent": true
    },
    {
      "source": "/outils/:path*",
      "destination": "/marketplace",
      "permanent": true
    },
    {
      "source": "/donnees-publiques",
      "destination": "/objectifs",
      "permanent": true
    },
    {
      "source": "/cas-usage/sector",
      "destination": "/cas-usage",
      "permanent": true
    },
    {
      "source": "/cas-usage/sector/:path*",
      "destination": "/cas-usage",
      "permanent": true
    },
    {
      "source": "/marketplace/outils/%5Bslug%5D",
      "destination": "/marketplace",
      "permanent": true
    },
    {
      "source": "/marketplace/category",
      "destination": "/marketplace",
      "permanent": true
    },
    {
      "source": "/marketplace/category/:path*",
      "destination": "/marketplace",
      "permanent": true
    },
    {
      "source": "/cas-usage/\\[sector\\]",
      "destination": "/404",
      "permanent": true
    },
    {
      "source": "/cas-usage/\\[sector\\]/:path*",
      "destination": "/404",
      "permanent": true
    },
    {
      "source": "/cas-usage/:path*/\\[slug\\]",
      "destination": "/404",
      "permanent": true
    },
    {
      "source": "/marketplace/\\[category\\]",
      "destination": "/404",
      "permanent": true
    },
    {
      "source": "/marketplace/\\[category\\]/:path*",
      "destination": "/404",
      "permanent": true
    },
    {
      "source": "/marketplace/:path*/\\[slug\\]",
      "destination": "/404",
      "permanent": true
    },
    {
      "source": "/blog/\\[slug\\]",
      "destination": "/404",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://www.corentinrobert.fr/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "corentinrobert.fr"
        }
      ],
      "destination": "https://www.corentinrobert.fr/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
